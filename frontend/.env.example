# Server-only public Store API URL. No consumer credentials required.
WC_STORE_URL=https://lockcityclothes.com

# Keep false until a controlled checkout execution is explicitly approved.
PAYPAL_CHECKOUT_EXECUTION_ENABLED=false

# Server-only secrets for validating the WordPress return bridge and signing
# the short-lived confirmation cookie. Use distinct random values (32+ chars).
CHECKOUT_BRIDGE_SECRET=
CHECKOUT_RETURN_SECRET=

# Server-only Double Opt-In newsletter configuration.
BREVO_API_KEY=
BREVO_LIST_ID=2
BREVO_DOI_TEMPLATE_ID=1
# Optional override. Defaults to https://lock-city.vercel.app/join/confirmed
BREVO_DOI_REDIRECT_URL=
